PORT=8080

# LINE Messaging API
LINE_CHANNEL_TOKEN=YOUR_LINE_CHANNEL_ACCESS_TOKEN
LINE_CHANNEL_SECRET=YOUR_LINE_CHANNEL_SECRET

# Forward webhook to external URL ("true" to enable)
FORWARD_WEBHOOK_URL_PROCESS=false
# Beacon API or other
FORWARD_WEBHOOK_URL=
# Admin UI (/admin) — ถ้าไม่ตั้ง ADMIN_PASSWORD หน้า admin และ API จะปิด (503)
ADMIN_PASSWORD=
# ไม่บังคับ: secret สำหรับเซ็น token ถ้าไม่ตั้งจะ derive จาก ADMIN_PASSWORD
ADMIN_TOKEN_SECRET=
